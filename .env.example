# Copy to ~/.haas/.env (outside the synced repo) and fill in. See src/config.ts for every option.

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_ID=

PORT=8787
PUBLIC_URL=http://localhost:8787

# Sources
FREELANCER_TOKEN=
FREELANCER_SANDBOX_TOKEN=
RENTAHUMAN_API_KEY=
# Upwork GraphQL API (needs an approved Upwork API key). Either a user access token from the
# authorization-code flow, or client credentials (Enterprise accounts only).
UPWORK_ACCESS_TOKEN=
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_TENANT_ID=
UPWORK_TIMEOUT_MS=8000
# Prolific participant pool (researcher account -> API token). Studies are created as drafts;
# publishing waits for your approval.
PROLIFIC_API_TOKEN=
PROLIFIC_PROJECT_ID=
PROLIFIC_TASK_URL=
PROLIFIC_TIMEOUT_MS=5000
PROLIFIC_HOURLY_REWARD_USD=12
PROLIFIC_DEFAULT_PLACES=20
PROLIFIC_DEFAULT_MINUTES=10
CHROME_CDP_URL=http://127.0.0.1:9222
# Opt-in browser-read sites: fiverr, peopleperhour, guru, upwork-browser
BROWSER_SITES=fiverr

# Masumi job fee (leave MASUMI_API_KEY empty to run jobs without payment)
MASUMI_API_URL=http://localhost:3001/api/v1
MASUMI_API_KEY=
MASUMI_NETWORK=Preprod
MASUMI_AGENT_IDENTIFIER=
MASUMI_SELLER_VKEY=
# Printed by `pnpm register:agent`. Pricing is Dynamic: 1 test USDM per job (MASUMI_PRICE_AMOUNT / MASUMI_PRICE_UNIT).
MASUMI_PRICING_TYPE=Dynamic
MASUMI_SUPPORTED_PAYMENT_SOURCE_INDEX=
MASUMI_SMART_CONTRACT_ADDRESS=
# Ed25519 seed (64 hex) that signs /provide_input; empty: generated once and kept in the database.
MASUMI_SIGNING_KEY=
# Accept /provide_input without input_schema_hash (older clients). A wrong hash is always rejected.
MASUMI_LENIENT_SCHEMA_HASH=false
# Deadlines in minutes (defaults shown): pay, result, unlock after result, dispute after unlock.
MASUMI_PAY_WINDOW_MIN=20
MASUMI_RESULT_WINDOW_MIN=90
MASUMI_UNLOCK_DELAY_MIN=16
MASUMI_DISPUTE_DELAY_MIN=16

# Sokosumi Coworker worker (runs when both are set). One worker per Coworker.
SOKOSUMI_COWORKER_ID=
SOKOSUMI_COWORKER_API_KEY=
SOKOSUMI_API_URL=https://api.preprod.sokosumi.com
# Organization id, "personal", or empty for every Workspace the Coworker has access to.
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_PAID_TASKS=false
SOKOSUMI_PAY_WINDOW_MIN=15
SOKOSUMI_RESULT_WINDOW_MIN=25
SOKOSUMI_UNLOCK_DELAY_MIN=16
SOKOSUMI_DISPUTE_DELAY_MIN=16

# x402 paywall (docs/X402.md). One 402 offers each listed network whose pay-to address is set.
# X402_NETWORK: cardano:preprod | solana:devnet | both, comma-separated (mainnet ids too)
X402_NETWORK=cardano:preprod,solana:devnet
# auto = stablecoin per chain (USDM on Cardano, USDC on Solana); ADA = tADA on Cardano
X402_ASSET=auto
X402_PRICE_USD=0.5
# Cardano: receiving address. Facilitator: hosted Cardano Foundation one unless set; the
# self-hosted one (infra/x402-facilitator) is the fallback.
X402_PAY_TO=
X402_FACILITATOR_URL=
X402_FACILITATOR_FALLBACK_URL=http://localhost:4022
# Solana: receiving wallet (base58); facilitator x402.org (devnet)
X402_SOLANA_PAY_TO=
# Spike clients (pnpm spike:x402 cardano|solana)
BLOCKFROST_PROJECT_ID=
X402_CLIENT_MNEMONIC=
X402_SOLANA_CLIENT_SECRET=

# Booking budget escrow: memory | solana
ESCROW_PROVIDER=memory
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_OPERATOR_SECRET=

# Speed: one routing request answers within this budget; slower sources are marked late and
# fill the cache for next time. Per-source caps: "freelancer:8000,rentahuman:5000".
SEARCH_BUDGET_MS=6000
SOURCE_TIMEOUTS=
# Browser-read sources (Fiverr and co.) are opt-in and never block a search.
BROWSER_SOURCES=false
# Stage demo: pinned cache plus fixtures, ~2 s shortlists. Warm first with `pnpm demo:warm`.
DEMO_MODE=false
DEMO_BUDGET_MS=2000
# Scoring weight overrides per task type, e.g. {"in_person":{"location":0.4}}
ROUTER_WEIGHTS=
