# Copy to ~/.haas/.env (outside the synced repo) and fill in. See src/config.ts for every option.

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_ID=

PORT=8787
PUBLIC_URL=http://localhost:8787

# Sources
FREELANCER_TOKEN=
FREELANCER_SANDBOX_TOKEN=
RENTAHUMAN_API_KEY=
CHROME_CDP_URL=http://127.0.0.1:9222
BROWSER_SITES=fiverr

# Masumi job fee (leave MASUMI_API_KEY empty to run jobs without payment)
MASUMI_API_URL=http://localhost:3001/api/v1
MASUMI_API_KEY=
MASUMI_NETWORK=Preprod
MASUMI_AGENT_IDENTIFIER=
MASUMI_SELLER_VKEY=

# x402 paywall on Cardano Preprod (leave X402_PAY_TO empty to disable)
X402_FACILITATOR_URL=http://localhost:4022
X402_PAY_TO=
BLOCKFROST_PROJECT_ID=
X402_CLIENT_MNEMONIC=

# Booking budget escrow: memory | solana
ESCROW_PROVIDER=memory
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_OPERATOR_SECRET=

# AI-first delegation: try a Masumi AI agent before searching for humans.
# auto = classify each brief (digital -> AI agent, else human); ai / human = force a path; off = disable.
AI_DELEGATION=auto
AI_TIME_BUDGET_MS=60000
AI_CLASSIFY_TIMEOUT_MS=1800
# Pinned agent (MIP-003 base URL) so the demo never depends on registry search.
AI_AGENT_URL=
AI_AGENT_IDENTIFIER=
AI_AGENT_NAME=
# input_data key for the task text; empty = guess from the agent's input_schema
AI_AGENT_INPUT_KEY=
# true = never lock funds (demo); agents answering payment_required=false are free anyway
AI_AGENT_FREE=false
# Registry Service search (optional), filtered by tags/capability and an allowlist of agentIdentifiers
MASUMI_REGISTRY_URL=
MASUMI_REGISTRY_TOKEN=
AI_AGENT_TAGS=
AI_AGENT_CAPABILITY=
AI_AGENT_ALLOWLIST=
# Buyer payment-service key for /purchase (defaults to MASUMI_API_KEY)
MASUMI_BUYER_API_KEY=
