# Copy to ~/.haas/.env (outside the synced repo) and fill in. See src/config.ts for every option.

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_ID=

PORT=8787
PUBLIC_URL=http://localhost:8787

# Sources
FREELANCER_TOKEN=
FREELANCER_SANDBOX_TOKEN=
RENTAHUMAN_API_KEY=
CHROME_CDP_URL=http://127.0.0.1:9222
BROWSER_SITES=fiverr

# Masumi job fee (leave MASUMI_API_KEY empty to run jobs without payment)
MASUMI_API_URL=http://localhost:3001/api/v1
MASUMI_API_KEY=
MASUMI_NETWORK=Preprod
MASUMI_AGENT_IDENTIFIER=
MASUMI_SELLER_VKEY=

# x402 paywall on Cardano Preprod (leave X402_PAY_TO empty to disable)
X402_FACILITATOR_URL=http://localhost:4022
X402_PAY_TO=
BLOCKFROST_PROJECT_ID=
X402_CLIENT_MNEMONIC=

# Booking budget escrow: memory | solana
ESCROW_PROVIDER=memory
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_OPERATOR_SECRET=

# Worker identity and on-chain reputation on Cardano (src/identity, docs/IDENTITY.md).
# Off unless both BLOCKFROST_PROJECT_ID (a preprod project, shared with x402 above) and
# CARDANO_MINT_MNEMONIC are set. `pnpm identity:wallet` prints a fresh mnemonic and its address;
# fund that address with test ADA from https://dispenser.masumi.network (or the Cardano testnet faucet).
CARDANO_NETWORK=preprod
CARDANO_MINT_MNEMONIC=
# Optional: freeze the minting policy after this absolute slot (no new credentials or receipts after it).
IDENTITY_POLICY_LOCK_SLOT=
IDENTITY_VERIFY_GRACE_MIN=10
IDENTITY_REQUIRE_VERIFICATION=false
IDENTITY_RECEIPTS=true
