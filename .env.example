# Copy to ~/.haas/.env (outside the synced repo) and fill in. See src/config.ts for every option.

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_ID=

PORT=8787
PUBLIC_URL=http://localhost:8787

# Sources
FREELANCER_TOKEN=
FREELANCER_SANDBOX_TOKEN=
RENTAHUMAN_API_KEY=
CHROME_CDP_URL=http://127.0.0.1:9222
BROWSER_SITES=fiverr

# Masumi job fee (leave MASUMI_API_KEY empty to run jobs without payment)
MASUMI_API_URL=http://localhost:3001/api/v1
MASUMI_API_KEY=
MASUMI_NETWORK=Preprod
MASUMI_AGENT_IDENTIFIER=
MASUMI_SELLER_VKEY=

# x402 paywall on Cardano Preprod (leave X402_PAY_TO empty to disable)
X402_FACILITATOR_URL=http://localhost:4022
X402_PAY_TO=
BLOCKFROST_PROJECT_ID=
X402_CLIENT_MNEMONIC=

# Booking budget escrow: memory | solana-program (on-chain haas-escrow) | solana-vault (server-held wallet)
ESCROW_PROVIDER=memory
SOLANA_RPC_URL=https://api.devnet.solana.com
# Base58 64-byte secret key of the operator: escrow authority (releases, cancels), pays fees.
SOLANA_OPERATOR_SECRET=
# Devnet USDC (Circle faucet). Any 6-decimal SPL mint works for testing.
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Deployed haas-escrow program (programs/haas-escrow/README.md).
SOLANA_ESCROW_PROGRAM_ID=9hzyeY6LPaQzJWszBjtYU17sHN2XmQD6FmyJFCNrs727
# Minutes the hirer has to lock the budget before the booking is cancelled.
ESCROW_DEPOSIT_TIMEOUT_MIN=60
# Escrow deadline = delivery window (brief, else this many days) + grace hours for review.
ESCROW_DELIVERY_DAYS=14
ESCROW_GRACE_HOURS=24
# Demo: deadline this many minutes after booking instead (0 = off).
ESCROW_DEADLINE_MIN=0
