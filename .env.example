# Copy to ~/.haas/.env (outside the synced repo) and fill in. See src/config.ts for every option.

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_ID=

PORT=8787
PUBLIC_URL=http://localhost:8787

# Sources
FREELANCER_TOKEN=
FREELANCER_SANDBOX_TOKEN=
RENTAHUMAN_API_KEY=
# Upwork GraphQL API (needs an approved Upwork API key). Either a user access token from the
# authorization-code flow, or client credentials (Enterprise accounts only).
UPWORK_ACCESS_TOKEN=
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_TENANT_ID=
UPWORK_TIMEOUT_MS=8000
# Prolific participant pool (researcher account -> API token). Studies are created as drafts;
# publishing waits for your approval.
PROLIFIC_API_TOKEN=
PROLIFIC_PROJECT_ID=
PROLIFIC_TASK_URL=
PROLIFIC_TIMEOUT_MS=5000
PROLIFIC_HOURLY_REWARD_USD=12
PROLIFIC_DEFAULT_PLACES=20
PROLIFIC_DEFAULT_MINUTES=10
CHROME_CDP_URL=http://127.0.0.1:9222
# Opt-in browser-read sites: fiverr, peopleperhour, guru, upwork-browser
BROWSER_SITES=fiverr

# Masumi job fee (leave MASUMI_API_KEY empty to run jobs without payment)
MASUMI_API_URL=http://localhost:3001/api/v1
MASUMI_API_KEY=
MASUMI_NETWORK=Preprod
MASUMI_AGENT_IDENTIFIER=
MASUMI_SELLER_VKEY=
# Printed by `pnpm register:agent`. Pricing is Dynamic: 1 test USDM per job (MASUMI_PRICE_AMOUNT / MASUMI_PRICE_UNIT).
MASUMI_PRICING_TYPE=Dynamic
MASUMI_SUPPORTED_PAYMENT_SOURCE_INDEX=
MASUMI_SMART_CONTRACT_ADDRESS=
# Ed25519 seed (64 hex) that signs /provide_input; empty: generated once and kept in the database.
MASUMI_SIGNING_KEY=
# Accept /provide_input without input_schema_hash (older clients). A wrong hash is always rejected.
MASUMI_LENIENT_SCHEMA_HASH=false
# Deadlines in minutes (defaults shown): pay, result, unlock after result, dispute after unlock.
MASUMI_PAY_WINDOW_MIN=20
MASUMI_RESULT_WINDOW_MIN=90
MASUMI_UNLOCK_DELAY_MIN=16
MASUMI_DISPUTE_DELAY_MIN=16

# Sokosumi Coworker worker (runs when both are set). One worker per Coworker.
SOKOSUMI_COWORKER_ID=
SOKOSUMI_COWORKER_API_KEY=
SOKOSUMI_API_URL=https://api.preprod.sokosumi.com
# Organization id, "personal", or empty for every Workspace the Coworker has access to.
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_PAID_TASKS=false
SOKOSUMI_PAY_WINDOW_MIN=15
SOKOSUMI_RESULT_WINDOW_MIN=25
SOKOSUMI_UNLOCK_DELAY_MIN=16
SOKOSUMI_DISPUTE_DELAY_MIN=16

# x402 paywall (docs/X402.md). One 402 offers each listed network whose pay-to address is set.
# X402_NETWORK: cardano:preprod | solana:devnet | both, comma-separated (mainnet ids too)
X402_NETWORK=cardano:preprod,solana:devnet
# auto = stablecoin per chain (USDM on Cardano, USDC on Solana); ADA = tADA on Cardano
X402_ASSET=auto
X402_PRICE_USD=0.5
# Cardano: receiving address. Facilitator: hosted Cardano Foundation one unless set; the
# self-hosted one (infra/x402-facilitator) is the fallback.
X402_PAY_TO=
X402_FACILITATOR_URL=
X402_FACILITATOR_FALLBACK_URL=http://localhost:4022
# Solana: receiving wallet (base58); facilitator x402.org (devnet)
X402_SOLANA_PAY_TO=
# Spike clients (pnpm spike:x402 cardano|solana)
BLOCKFROST_PROJECT_ID=
X402_CLIENT_MNEMONIC=
X402_SOLANA_CLIENT_SECRET=

# Booking budget escrow: memory | solana-program (on-chain haas-escrow) | solana-vault (server-held wallet)
ESCROW_PROVIDER=memory
SOLANA_RPC_URL=https://api.devnet.solana.com
# Base58 64-byte secret key of the operator: escrow authority (releases, cancels), pays fees.
SOLANA_OPERATOR_SECRET=
# Devnet USDC (Circle faucet). Any 6-decimal SPL mint works for testing.
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Deployed haas-escrow program (programs/haas-escrow/README.md).
SOLANA_ESCROW_PROGRAM_ID=9hzyeY6LPaQzJWszBjtYU17sHN2XmQD6FmyJFCNrs727
# Minutes the hirer has to lock the budget before the booking is cancelled.
ESCROW_DEPOSIT_TIMEOUT_MIN=60
# Escrow deadline = delivery window (brief, else this many days) + grace hours for review.
ESCROW_DELIVERY_DAYS=14
ESCROW_GRACE_HOURS=24
# Demo: deadline this many minutes after booking instead (0 = off).
ESCROW_DEADLINE_MIN=0

# Speed: one routing request answers within this budget; slower sources are marked late and
# fill the cache for next time. Per-source caps: "freelancer:8000,rentahuman:5000".
SEARCH_BUDGET_MS=6000
SOURCE_TIMEOUTS=
# Browser-read sources (Fiverr and co.) are opt-in and never block a search.
BROWSER_SOURCES=false
# Stage demo: pinned cache plus fixtures, ~2 s shortlists. Warm first with `pnpm demo:warm`.
DEMO_MODE=false
DEMO_BUDGET_MS=2000
# Scoring weight overrides per task type, e.g. {"in_person":{"location":0.4}}
ROUTER_WEIGHTS=

# AI-first delegation: try a Masumi AI agent before searching for humans.
# auto = classify each brief (digital -> AI agent, else human); ai / human = force a path; off = disable.
AI_DELEGATION=auto
AI_TIME_BUDGET_MS=60000
AI_CLASSIFY_TIMEOUT_MS=1800
# Pinned agent (MIP-003 base URL) so the demo never depends on registry search.
AI_AGENT_URL=
AI_AGENT_IDENTIFIER=
AI_AGENT_NAME=
# input_data key for the task text; empty = guess from the agent's input_schema
AI_AGENT_INPUT_KEY=
# true = never lock funds (demo); agents answering payment_required=false are free anyway
AI_AGENT_FREE=false
# Registry Service search (optional), filtered by tags/capability and an allowlist of agentIdentifiers
MASUMI_REGISTRY_URL=
MASUMI_REGISTRY_TOKEN=
AI_AGENT_TAGS=
AI_AGENT_CAPABILITY=
AI_AGENT_ALLOWLIST=
# Buyer payment-service key for /purchase (defaults to MASUMI_API_KEY)
MASUMI_BUYER_API_KEY=

# Quality check of deliveries before escrow release
MODEL_VERIFY=claude-haiku-4-5-20251001
MODEL_VERIFY_STRONG=claude-opus-5-5
VERIFY_STRONG_MIN_USD=250
VERIFY_TIMEOUT_MS=8000
VERIFY_URL_TIMEOUT_MS=2500
# Release without asking when QA passed and the booking costs at most this (0 = always ask)
AUTO_RELEASE_MAX_USD=0
AUTO_QA_REVISION=true


# Worker identity and on-chain reputation on Cardano (src/identity, docs/IDENTITY.md).
# Off unless both BLOCKFROST_PROJECT_ID (a preprod project, shared with x402 above) and
# CARDANO_MINT_MNEMONIC are set. `pnpm identity:wallet` prints a fresh mnemonic and its address;
# fund that address with test ADA from https://dispenser.masumi.network (or the Cardano testnet faucet).
CARDANO_NETWORK=preprod
CARDANO_MINT_MNEMONIC=
# Optional: freeze the minting policy after this absolute slot (no new credentials or receipts after it).
IDENTITY_POLICY_LOCK_SLOT=
IDENTITY_VERIFY_GRACE_MIN=10
IDENTITY_REQUIRE_VERIFICATION=false
IDENTITY_RECEIPTS=true

# Public agent line (messages/). CHANNEL: twilio (dedicated number) | imessage (Mac's identity) | console
CHANNEL=imessage
# imessage: the operator's own handle (approvals land there). macOS only.
IMESSAGE_RECIPIENT=
# twilio: the agent's dedicated number. Get a free trial number at twilio.com
# (trial texts only verified numbers). Fill these in yourself; never commit them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# twilio: the operator's own mobile; approvals and unattributed events go there.
OWNER_PHONE=
# true: also text per-step progress (searching, scoring, per-source timings)
IMESSAGE_VERBOSE=false
