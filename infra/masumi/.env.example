# Copy to infra/masumi/.env and fill in. Never commit the real file.

# openssl rand -hex 24   (32+ chars). Encrypts wallet secrets in the database: losing it loses the wallets.
ENCRYPTION_KEY=
# openssl rand -hex 16   (15+ chars). The all-powerful admin key.
ADMIN_KEY=
# Free key for the Preprod network: https://blockfrost.io
BLOCKFROST_API_KEY_PREPROD=

# Optional. Leave blank to let the seed generate wallets (printed once in the logs).
PURCHASE_WALLET_PREPROD_MNEMONIC=
SELLING_WALLET_PREPROD_MNEMONIC=
COLLECTION_WALLET_PREPROD_ADDRESS=

POSTGRES_PASSWORD=postgres
