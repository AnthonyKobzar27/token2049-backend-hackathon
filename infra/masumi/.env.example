# Copy to infra/masumi/.env (git-ignored). Never change ENCRYPTION_KEY after the first start: it decrypts the wallets.
# ENCRYPTION_KEY=$(openssl rand -hex 24)
ENCRYPTION_KEY=
# 32+ characters: ADMIN_KEY=$(openssl rand -hex 24)
ADMIN_KEY=
# Preprod project at https://blockfrost.io
BLOCKFROST_API_KEY_PREPROD=
POSTGRES_PASSWORD=postgres
# Optional: reuse existing wallets instead of generating new ones.
PURCHASE_WALLET_PREPROD_MNEMONIC=
SELLING_WALLET_PREPROD_MNEMONIC=
# Do not add COLLECTION_WALLET_V2_PREPROD_ADDRESS, not even empty.
# 1 prints the seed output (it can include mnemonics) to the logs. Laptop only.
SEED_LOG=0
