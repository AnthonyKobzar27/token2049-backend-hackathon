# Required: Blockfrost PREPROD project id (https://blockfrost.io, create a Cardano Preprod project).
BLOCKFROST_PROJECT_ID=
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
PORT=4022
# true accepts the facilitator's own broadcast as evidence (confirmation level -1; can be rolled back).
ACCEPT_MEMPOOL=false
# Bounded wait per /settle call; must stay below the resource server's facilitator timeout (120000 in HAAS).
CONFIRMATION_TIMEOUT_MS=75000
