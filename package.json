{
  "name": "haas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HAAS (Human as a Service): an open router for freelancers, as a Masumi agent",
  "scripts": {
    "start": "tsx src/index.ts",
    "frontend": "pnpm --dir frontend dev",
    "messages": "pnpm --dir messages start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "spike:masumi": "tsx scripts/masumi-spike.ts",
    "spike:x402": "tsx scripts/x402-spike.ts",
    "spike:solana": "tsx scripts/solana-spike.ts",
    "smoke:browser": "tsx scripts/browser-smoke.ts",
    "demo:warm": "tsx scripts/demo-warm.ts",
    "register:agent": "tsx scripts/register-agent.ts",
    "sokosumi:worker": "tsx scripts/sokosumi-worker.ts",
    "seed:workers": "tsx scripts/seed-workers.ts",
    "demo:bounty": "tsx scripts/demo-bounty.ts",
    "identity:wallet": "tsx scripts/mint-credential.ts --new-wallet",
    "identity:mint": "tsx scripts/mint-credential.ts",
    "identity:demo": "tsx scripts/reputation-demo.ts",
    "veridian:schema": "tsx src/identity/veridian/schema.ts",
    "veridian:demo": "tsx scripts/veridian-demo.ts",
    "veridian:wallet": "tsx scripts/veridian-wallet.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@meshsdk/core": "^1.9.1",
    "@solana/kit": "^8.4.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@x402/cardano": "~2.28.0",
    "@x402/core": "~2.28.0",
    "@x402/express": "~2.28.0",
    "@x402/fetch": "~2.28.0",
    "@x402/paywall": "~2.28.0",
    "@x402/svm": "~2.28.0",
    "bs58": "^6.0.0",
    "express": "^5.2.1",
    "grammy": "^1.46.0",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "signify-ts": "0.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@meshsdk/core-cst": "1.9.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "litesvm": "^1.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
